# ================= UZUZ backend (NestJS) =================
PORT=4000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas yoki lokal mongod).
# Development'da BO'SH qoldirsangiz, o'rnatilgan (embedded) MongoDB ishga tushadi,
# ma'lumotlar backend/.mongo-data papkasida saqlanadi (birinchi ishga tushishda ~100MB yuklab olinadi).
# Production'da MAJBURIY.
MONGODB_URI=

# Frontend manzil(lar)i — CORS va Socket.IO uchun. Bir nechta bo'lsa vergul bilan.
# Lokal: http://localhost:5173   Production: https://uzuz.vercel.app
CLIENT_URL=http://localhost:5173

# Cookie sozlamalari.
# Lokal (Vite proxy orqali, bitta origin): COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Frontend va backend turli domenlarda (Vercel + Render): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Backend oldidagi reverse proxy'lar soni (Render/Railway/Fly = 1).
TRUST_PROXY=0

# Ixtiyoriy: admin hali yo'q bo'lsa, ishga tushishda shu login bilan yaratiladi (parol >= 10 belgi).
ADMIN_USERNAME=
ADMIN_PASSWORD=
